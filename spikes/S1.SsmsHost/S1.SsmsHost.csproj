<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <!--
    Spike S1: throwaway SSMS 21/22 extension (in-proc, .NET Framework 4.8, VS 2022 shell APIs).
    Not part of SqlCompanion.slnx: VSIX packaging needs Windows MSBuild. Built by .github/workflows/spike-s1-vsix.yml.
    SDK versions match a maintained SSMS 21/22 extension (ErikEJ/SqlCeToolbox).
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>SqlCompanion.Spikes.S1</RootNamespace>
    <AssemblyName>SqlCompanion.S1.SsmsHost</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Throwaway spike: keep warnings visible without failing the build on VS SDK analyzers. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>true</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
    <CreateVsixContainer>true</CreateVsixContainer>
    <DeployExtension>false</DeployExtension>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Design" />
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest" SubType="Designer" />
    <VSCTCompile Include="SsmsHostPackage.vsct" ResourceName="Menus.ctmenu" />
  </ItemGroup>

  <!--
    Step 2: ship the .NET 10 engine (sqlwc-lsp) inside the VSIX under server\. SSMS runs .NET Framework 4.8, so the
    engine runs out of process; framework-dependent publish needs the .NET 10 runtime on the machine.
  -->
  <PropertyGroup>
    <EngineProject>$(MSBuildThisFileDirectory)..\..\src\SqlCompanion.Server.Lsp\SqlCompanion.Server.Lsp.csproj</EngineProject>
    <EnginePublishDir>$(MSBuildThisFileDirectory)obj\engine\</EnginePublishDir>
  </PropertyGroup>
  <Target Name="PublishEngine" BeforeTargets="BeforeBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="dotnet publish &quot;$(EngineProject)&quot; -c Release -r win-x64 --self-contained false -o &quot;$(EnginePublishDir)&quot; -p:GenerateDocumentationFile=false --nologo" />
    <ItemGroup>
      <Content Include="$(EnginePublishDir)**\*" Exclude="$(EnginePublishDir)**\*.pdb">
        <IncludeInVSIX>true</IncludeInVSIX>
        <VSIXSubPath>server\%(RecursiveDir)</VSIXSubPath>
      </Content>
    </ItemGroup>
  </Target>

  <!--
    VSIX packaging (pkgdef, VSCT, .vsix container) lives in Microsoft.VsSDK.targets. Microsoft.VSSDK.BuildTools
    points VSToolsPath at its own copy but, as in classic projects, the import is the project's job and must
    come after the SDK targets — hence explicit Sdk.props/Sdk.targets imports instead of <Project Sdk="…">.
  -->
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="Exists('$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets')" />
</Project>
